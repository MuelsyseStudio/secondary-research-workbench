# Secondary Research Workbench (Open-Source Edition) Environment Variables
# Copy or export as needed; all values below are optional defaults.

# Local HTTP server port (binds to 127.0.0.1 only)
PORT=3721

# Custom workspace root directory containing "现行三库/"
# Defaults to ./data when running standalone
SRW_DATA_DIR=./data

# Runtime edition identifier
SRW_EDITION=open_source
